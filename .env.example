# Public browser configuration. Security is enforced by Supabase RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_UPLOAD_MAX_MB=10
UPLOAD_MAX_MB=10

# Server/scripts only. Never prefix this key with VITE_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Una o più origini esatte separate da virgola. Su Vercel vengono accettati anche
# il dominio Production e il deployment corrente forniti automaticamente.
APP_ORIGIN=http://localhost:5173

# Used only by npm run admin:create.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by optional scripts.
SEED_AUTHOR_ID=
SQLITE_SOURCE=./data/app.sqlite
SQLITE_UPLOADS=./data/uploads

# Only for npm run test:e2e, in an isolated test project with an admin account.
E2E_EMAIL=
E2E_PASSWORD=
